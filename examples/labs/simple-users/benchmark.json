{
  "benchmark_id": "simple_users_lab_benchmark",
  "benchmark_name": "Simple Users Lab Safe Benchmark",
  "benchmark_version": "0.1.0",
  "description": "Safe dry-run benchmark configuration for the simple-users lab pack.",
  "random_seed": 0,
  "output_naming_strategy": "job_id",
  "jobs": [
    {
      "job_id": "simple_users_lab_dry_run",
      "job_name": "Simple Users Lab Dry Run",
      "target_name": "simple-users-api",
      "base_url": "http://localhost:8000",
      "openapi_path": "examples/labs/simple-users/openapi.yaml",
      "ground_truth_path": "examples/labs/simple-users/ground_truth.json",
      "output_subdir": "simple_users_lab_dry_run",
      "max_requests": 3,
      "timeout": 5.0,
      "dry_run": true,
      "allow_destructive": false,
      "include_boundary_payloads": true,
      "include_invalid_payloads": true,
      "include_mutated_payloads": true,
      "include_attack_payloads": true,
      "execute_mutations": false,
      "execute_attacks": false,
      "enabled_attack_categories": ["SQL_INJECTION", "INPUT_VALIDATION", "INFORMATION_DISCLOSURE"],
      "max_mutations_per_payload": 10,
      "max_mutations_per_field": 2,
      "max_attack_requests_per_endpoint": 1,
      "notes": "Dry-run only; no requests are sent and attack/mutation execution remains disabled.",
      "metadata": {
        "lab_id": "simple-users",
        "safe_for_local_tests": true
      }
    }
  ]
}
